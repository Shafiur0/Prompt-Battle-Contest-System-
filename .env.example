# Private local configuration. Copy to .env; never commit API keys.
NODE_ENV=development
APP_ORIGIN=http://localhost:3100
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000
DATABASE_URL=postgresql://prompt_battle:local-development-only@localhost:5432/prompt_battle
# If Windows reserves port 5432, change both this port and DATABASE_URL to an available port.
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_GENERATION_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_JUDGE_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_REVIEWER_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_GENERATION_PROVIDER=Fireworks
OPENROUTER_REVIEWER_PROVIDER=Anthropic
# Complete counted-input bound is UNVERIFIED until qualification; do not infer it from this context ceiling.
GENERATION_INPUT_UPPER_BOUND=1048576
GENERATION_MAX_OUTPUT_TOKENS=8192
OFFICIAL_PROVIDER_QUALIFIED=false
KEYCLOAK_ISSUER=http://localhost:8080/realms/prompt-battle
KEYCLOAK_CLIENT_ID=prompt-battle
KEYCLOAK_CLIENT_SECRET=local-client-secret-change-before-deployment
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=local-minio
MINIO_SECRET_KEY=local-minio-secret-change-before-deployment
MINIO_BUCKET=prompt-battle-artifacts
# Relative path to a separately reviewed approval/evidence manifest; leave blank for calibration.
MODEL_QUALIFICATION_MANIFEST=
